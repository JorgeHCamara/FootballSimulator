# Optional. Free key from https://www.football-data.org/client/register
# Without it the site runs on generated sample leagues.
FOOTBALL_DATA_API_KEY=

# Public URL used in the sitemap, canonical links and social previews.
NEXT_PUBLIC_SITE_URL=https://footsimu.com

# Set to "false" to show initials badges instead of club crests.
NEXT_PUBLIC_SHOW_CRESTS=true

# Google Search Console HTML-tag verification code (content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Where the running site reads the daily job's odds snapshots and xG from
# (see "Published data" in the README). Unset: main's files on GitHub when running
# on Vercel, the files on disk anywhere else. "off": the files on disk only.
FOOTSIMU_DATA_URL=
